#version 450
#ifdef FUSED
layout(local_size_x = 16, local_size_y = 4) in;
#else
layout(local_size_x = 64) in;
#endif
layout(set = 0, binding = 0, std430) readonly buffer Input { uint pixels[]; } input_frame;
layout(set = 0, binding = 1, std430) writeonly buffer Output { uint pixels[]; } output_frame;
struct Coefficient { int index; float weight; };
layout(set = 0, binding = 2, std430) readonly buffer Coefficients { Coefficient taps[]; } coefficients;
layout(push_constant) uniform Shape { int dw; int dh; int amount; int sw; int sh; int pass; } shape;
layout(constant_id = 0) const int fixed_dw = 1920;
layout(constant_id = 1) const int fixed_dh = 1080;
layout(constant_id = 2) const int fixed_sw = 960;
layout(constant_id = 3) const int fixed_sh = 540;
layout(constant_id = 4) const int fixed_pass = 0;

float spline(float distance)
{
    float x = abs(distance);
    if (x < 1) return 1 + x * (-3.0/209 + x * (-453.0/209 + x * 13.0/11));
    if (x < 2) { x -= 1; return x * (-156.0/209 + x * (270.0/209 - x * 6.0/11)); }
    if (x < 3) { x -= 2; return x * (26.0/209 + x * (-45.0/209 + x / 11)); }
    return 0;
}

int mirror(int position, int size)
{
    if (position < 0) position = -position - 1;
    if (position >= size) position = 2 * size - position - 1;
    return clamp(position, 0, size - 1);
}

ivec3 plane(uint index, int width, int height)
{
    int offset = 0;
    if (index >= uint(width * height)) {
        int which = (int(index) - width * height) / (width * height / 4);
        offset = width * height + which * (width * height / 4);
        width /= 2; height /= 2;
    }
    return ivec3(width, height, offset);
}

float horizontal(uint index)
{
    ivec3 dest = plane(index, fixed_dw, fixed_sh);
    ivec3 src = plane(index, fixed_dw, fixed_sh);
    src.x = dest.z == 0 ? fixed_sw : fixed_sw / 2;
    int which = dest.z == 0 ? 0 : (dest.z - fixed_dw * fixed_sh) / (fixed_dw * fixed_sh / 4);
    src.z = dest.z == 0 ? 0 : fixed_sw * fixed_sh + which * (fixed_sw * fixed_sh / 4);
    int x = (int(index) - dest.z) % dest.x;
    int y = (int(index) - dest.z) / dest.x;
    float position = (float(x) + 0.5) * float(src.x) / float(dest.x) - 0.5;
    int start = int(floor(position)) - 2;
    float value = 0, total = 0;
    for (int tap = 0; tap < 6; tap++) {
        float weight = spline(float(start + tap) - position);
        int sample_x = mirror(start + tap, src.x);
        if (fixed_pass >= 16) {
            int base = dest.z == 0 ? 0 : fixed_dw;
            Coefficient c = coefficients.taps[(base + x) * 6 + tap];
            weight = c.weight; sample_x = c.index;
        }
        uint address = uint(src.z + y * src.x + sample_x);
        uint pixel = (input_frame.pixels[address / 4] >> ((address % 4) * 8)) & 255;
        value += weight * float(pixel); total += weight;
    }
    return value / total;
}

uint vertical(uint index)
{
    ivec3 dest = plane(index, fixed_dw, fixed_dh);
    int src_height = dest.z == 0 ? fixed_sh : fixed_sh / 2;
    int which = dest.z == 0 ? 0 : (dest.z - fixed_dw * fixed_dh) / (fixed_dw * fixed_dh / 4);
    int offset = dest.z == 0 ? 0 : fixed_dw * fixed_sh + which * (fixed_dw * fixed_sh / 4);
    int x = (int(index) - dest.z) % dest.x;
    int y = (int(index) - dest.z) / dest.x;
    float position = (float(y) + 0.5) * float(src_height) / float(dest.y) - 0.5;
    int start = int(floor(position)) - 2;
    float value = 0, total = 0;
    for (int tap = 0; tap < 6; tap++) {
        float weight = spline(float(start + tap) - position);
        int sample_y = mirror(start + tap, src_height);
        if (fixed_pass >= 16) {
            int base = fixed_dw * 3 / 2 + (dest.z == 0 ? 0 : fixed_dh);
            Coefficient c = coefficients.taps[(base + y) * 6 + tap];
            weight = c.weight; sample_y = c.index;
        }
        uint address = uint(offset + sample_y * dest.x + x);
        value += weight * uintBitsToFloat(input_frame.pixels[address]); total += weight;
    }
    return uint(clamp(floor(value / total + 0.5), 0, 255));
}

#ifndef FUSED
void main()
{
    uint invocation = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * 64;
    if ((fixed_pass & 15) == 0) {
        if (invocation < uint(fixed_dw * fixed_sh * 3 / 2))
            output_frame.pixels[invocation] = floatBitsToUint(horizontal(invocation));
        return;
    }
    uint count = uint(fixed_dw * fixed_dh * 3 / 2);
    if (invocation >= (count + 3) / 4) return;
    uint value = 0;
    for (uint lane = 0; lane < 4; lane++) {
        uint index = invocation * 4 + lane;
        if (index < count) value |= vertical(index) << (lane * 8);
    }
    output_frame.pixels[invocation] = value;
}
#else
shared uint tile[6][66];

ivec4 tile_plane()
{
    int row = int(gl_WorkGroupID.y);
    int luma_rows = (fixed_dh + 3) / 4;
    if (row < luma_rows) return ivec4(fixed_dw, fixed_dh, 0, row * 4);
    row -= luma_rows;
    int chroma_rows = (fixed_dh / 2 + 3) / 4;
    int which = row / chroma_rows;
    return ivec4(fixed_dw / 2, fixed_dh / 2,
                 fixed_dw * fixed_dh + which * (fixed_dw * fixed_dh / 4),
                 (row % chroma_rows) * 4);
}

int blurred(int x, int y)
{
    return int(tile[y][x - 1] + 2 * tile[y][x] + tile[y][x + 1] + 2) / 4;
}

uint fused_pixel(int x, int y)
{
    int source = int(tile[y][x]);
    int blur = (blurred(x, y - 1) + 2 * blurred(x, y) + blurred(x, y + 1) + 2) / 4;
    int detail = shape.amount * (source - blur);
    int delta = detail / 256;
    if (detail < 0 && detail % 256 != 0) delta--;
    return uint(clamp(source + delta, 0, 255));
}

void main()
{
    ivec4 p = tile_plane();
    int left = int(gl_WorkGroupID.x) * 64;
    for (uint i = gl_LocalInvocationIndex; i < 396; i += 64) {
        int x = clamp(left + int(i % 66) - 1, 0, p.x - 1);
        int y = clamp(p.w + int(i / 66) - 1, 0, p.y - 1);
        tile[i / 66][i % 66] = vertical(uint(p.z + y * p.x + x));
    }
    barrier();
    int x = left + int(gl_LocalInvocationID.x) * 4;
    int y = p.w + int(gl_LocalInvocationID.y);
    if (x >= p.x || y >= p.y) return;
    uint value = 0;
    for (int lane = 0; lane < 4; lane++) {
        int tx = int(gl_LocalInvocationID.x) * 4 + lane + 1;
        int ty = int(gl_LocalInvocationID.y) + 1;
        uint pixel = p.z == 0 ? fused_pixel(tx, ty) : tile[ty][tx];
        value |= pixel << (lane * 8);
    }
    output_frame.pixels[(p.z + y * p.x + x) / 4] = value;
}
#endif

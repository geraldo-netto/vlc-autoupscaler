#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer Input { uint pixels[]; } input_frame;
layout(set = 0, binding = 1, std430) writeonly buffer Output { uint pixels[]; } output_frame;
layout(push_constant) uniform Shape { int width; int height; int amount; int sw; int sh; } shape;
layout(constant_id = 0) const int fixed_width = 1920;
layout(constant_id = 1) const int fixed_height = 1080;
layout(constant_id = 2) const int fixed_sw = 960;
layout(constant_id = 3) const int fixed_sh = 540;

int sample_pixel(int x, int y)
{
    uint index = uint(clamp(y, 0, fixed_height - 1) * fixed_width
                    + clamp(x, 0, fixed_width - 1));
    return int((input_frame.pixels[index / 4] >> ((index % 4) * 8)) & 255);
}

int horizontal(int x, int y)
{
    return (sample_pixel(x - 1, y) + 2 * sample_pixel(x, y)
          + sample_pixel(x + 1, y) + 2) / 4;
}

uint sharpen(uint index)
{
    if (index >= uint(fixed_width * fixed_height))
        return (input_frame.pixels[index / 4] >> ((index % 4) * 8)) & 255;
    int x = int(index) % fixed_width;
    int y = int(index) / fixed_width;
    int blur = (horizontal(x, y - 1) + 2 * horizontal(x, y)
              + horizontal(x, y + 1) + 2) / 4;
    int source = sample_pixel(x, y);
    int detail = shape.amount * (source - blur);
    int delta = detail / 256;
    if (detail < 0 && detail % 256 != 0) delta--;
    return uint(clamp(source + delta, 0, 255));
}

void main()
{
    uint word = gl_GlobalInvocationID.x;
    uint count = uint(fixed_width * fixed_height);
    if (fixed_sh > 0) count = count * 3 / 2;
    if (word >= (count + 3) / 4) return;
    uint value = 0;
    for (uint lane = 0; lane < 4; lane++) {
        uint index = word * 4 + lane;
        if (index < count) value |= sharpen(index) << (lane * 8);
    }
    output_frame.pixels[word] = value;
}

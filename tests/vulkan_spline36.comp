#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer Input { uint pixels[]; } input_frame;
layout(set = 0, binding = 1, std430) writeonly buffer Output { uint pixels[]; } output_frame;
layout(push_constant) uniform Shape { int dw; int dh; int unused; int sw; int sh; } shape;

float spline(float distance)
{
    float x = abs(distance);
    if (x < 1) return 1 + x * (-3.0/209 + x * (-453.0/209 + x * 13.0/11));
    if (x < 2) { x -= 1; return x * (-156.0/209 + x * (270.0/209 - x * 6.0/11)); }
    if (x < 3) { x -= 2; return x * (26.0/209 + x * (-45.0/209 + x / 11)); }
    return 0;
}

int mirror(int position, int size)
{
    if (position < 0) position = -position - 1;
    if (position >= size) position = 2 * size - position - 1;
    return clamp(position, 0, size - 1);
}

float sample_pixel(int x, int y, ivec2 size, int offset)
{
    uint index = uint(offset + mirror(y, size.y) * size.x + mirror(x, size.x));
    return float((input_frame.pixels[index / 4] >> ((index % 4) * 8)) & 255);
}

uint resample(uint index)
{
    ivec2 source = ivec2(shape.sw, shape.sh), dest = ivec2(shape.dw, shape.dh);
    int offset = 0;
    if (index >= uint(shape.dw * shape.dh)) {
        index -= uint(shape.dw * shape.dh);
        int plane = int(index) / (shape.dw * shape.dh / 4);
        index %= uint(shape.dw * shape.dh / 4);
        offset = shape.sw * shape.sh + plane * (shape.sw * shape.sh / 4);
        source /= 2; dest /= 2;
    }
    vec2 position = (vec2(int(index) % dest.x, int(index) / dest.x) + 0.5)
                  * vec2(source) / vec2(dest) - 0.5;
    ivec2 start = ivec2(floor(position)) - 2;
    float value = 0, total = 0;
    for (int y = 0; y < 6; y++) {
        float wy = spline(float(start.y + y) - position.y);
        for (int x = 0; x < 6; x++) {
            float weight = wy * spline(float(start.x + x) - position.x);
            value += weight * sample_pixel(start.x + x, start.y + y, source, offset);
            total += weight;
        }
    }
    return uint(clamp(floor(value / total + 0.5), 0, 255));
}

void main()
{
    uint word = gl_GlobalInvocationID.x;
    uint count = uint(shape.dw * shape.dh * 3 / 2);
    if (word >= (count + 3) / 4) return;
    uint value = 0;
    for (uint lane = 0; lane < 4; lane++) {
        uint index = word * 4 + lane;
        if (index < count) value |= resample(index) << (lane * 8);
    }
    output_frame.pixels[word] = value;
}
